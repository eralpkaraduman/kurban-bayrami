<!doctype html>
<!--
  Web page around a raylib game built with Emscripten. Shared by Kurban
  Bayrami and Time Escape: kept in https://github.com/eralpkaraduman/kurban-bayrami
  (port/web/), and Time Escape downloads it from there at a pinned commit.

  CMake fills in each placeholder, a name between two at signs, with
  configure_file(... @ONLY):
    WEB_TITLE          page title
    WEB_TOUCH_DPAD     D-pad keys, e.g. { left: 263, right: 262 }
    WEB_TOUCH_BUTTONS  round buttons, e.g. [{ label: 'X', caption: 'Jump', key: 88 }]
    WEB_TOUCH_TAP_CLICKS  optional: ON makes a tap on the game a mouse click
    WEB_TOUCH_STICK       optional: OFF shows arrow buttons instead of the thumb stick
  Key codes are raylib's. The game must export flx_touch_key(key, down).
-->
<html lang="en">
<head>
<meta charset="utf-8">
<!-- No zooming, and use the whole screen, notch included. -->
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#000000">
<!-- Launch full screen when added to the home screen. -->
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<meta name="format-detection" content="telephone=no">
<title>@WEB_TITLE@</title>
<link rel="stylesheet" href="touch-controls.css">
<style>
  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
  body { display: flex; align-items: center; justify-content: center; }
  #frame { display: flex; flex-direction: column; align-items: center; }
  /* Scale up without smoothing so the pixel art stays sharp on any screen. */
  canvas { display: block; image-rendering: pixelated; outline: none; }
  /* The download bar, shown until the game starts. */
  #loading { position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(240px, 60vw);
             color: #aaa; font: 13px/1.4 ui-monospace, monospace; text-align: center; }
  #loading-track { height: 6px; margin-top: 8px; border: 1px solid #666; }
  #loading-bar { width: 0; height: 100%; background: #ddd; }
</style>
</head>
<body>
<div id="frame">
  <canvas id="canvas" oncontextmenu="event.preventDefault()" tabindex="-1"></canvas>
</div>
<div id="loading" role="progressbar" aria-label="Loading the game">
  <div id="loading-text">Loading</div>
  <div id="loading-track"><div id="loading-bar"></div></div>
</div>
<script src="touch-controls.js"></script>
<script>
  var canvas = document.getElementById('canvas');

  // Touch controls under the game on touch screens, and the canvas scaling.
  var controls = TouchControls.setup({
    canvas: canvas,
    frame: document.getElementById('frame'),
    dpad: @WEB_TOUCH_DPAD@,
    stick: '@WEB_TOUCH_STICK@' !== 'OFF',
    buttons: @WEB_TOUCH_BUTTONS@,
    tapClicks: '@WEB_TOUCH_TAP_CLICKS@' === 'ON',
    onKey: function (key, down) {
      if (Module._flx_touch_key) Module._flx_touch_key(key, down ? 1 : 0);
    },
  });
  // Emscripten reports the data download as "Downloading data... (done/total)"
  // in bytes, and an empty status once the game runs.
  var loading = document.getElementById('loading');
  function hideLoading() { loading.hidden = true; }
  function setStatus(text) {
    var m = /\((\d+)\/(\d+)\)/.exec(text);
    if (m && text.indexOf('Downloading') === 0) {
      var done = +m[1], total = +m[2], mb = function (n) { return (n / 1048576).toFixed(1); };
      document.getElementById('loading-bar').style.width = (100 * done / total) + '%';
      document.getElementById('loading-text').textContent = 'Loading ' + mb(done) + ' / ' + mb(total) + ' MB';
      loading.setAttribute('aria-valuenow', Math.round(100 * done / total));
    } else if (!text) {
      hideLoading();
    }
  }
  var Module = { canvas: canvas, setStatus: setStatus, postRun: [controls.fit, hideLoading] };

  // itch.io embeds the game in an iframe. Keyboard input needs focus there.
  window.addEventListener('load', function () { window.focus(); canvas.focus(); });
  canvas.addEventListener('mousedown', function () { window.focus(); canvas.focus(); });
  // raylib cancels mouse wheel events on the canvas, so a page with the
  // game embedded could not scroll while the pointer is over the game. No
  // game here reads the wheel, so keep those events away from raylib.
  window.addEventListener('wheel', function (e) { e.stopPropagation(); }, { capture: true, passive: true });
  // Keep arrow keys and space from scrolling the itch.io page.
  window.addEventListener('keydown', function (e) {
    if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', ' '].indexOf(e.key) >= 0) e.preventDefault();
  });
</script>
{{{ SCRIPT }}}
</body>
</html>
